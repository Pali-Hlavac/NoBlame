{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "task",
  "description": "Task windows opened from the command line (`noblame commit <path>`, ...).",
  "windows": ["task-*"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-git-info",
    "allow-get-window-context"
  ]
}
