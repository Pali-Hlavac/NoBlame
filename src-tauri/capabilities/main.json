{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window. Grant each new app command explicitly.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-git-info",
    "allow-get-window-context",
    "allow-take-repository-requests",
    "allow-open-task-window"
  ]
}
