{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window. Grant each new app command explicitly.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-git-info",
    "allow-get-window-context",
    "allow-take-repository-requests",
    "allow-open-task-window",
    "allow-open-repository",
    "allow-init-repository",
    "allow-close-repository",
    "allow-load-graph",
    "allow-get-graph-block",
    "allow-reload-graph",
    "allow-set-graph-filter",
    "allow-find-commit",
    "allow-go-to-commit",
    "allow-refresh-repository",
    "allow-get-ancestry-block",
    "allow-get-commit-rows",
    "allow-write-commit-graph",
    "allow-list-recent-repositories",
    "allow-remove-recent-repository",
    "allow-get-commit-details",
    "allow-get-changed-files",
    "allow-get-comparison",
    "allow-count-ahead-behind",
    "allow-get-file-diff",
    "allow-get-diff-lines",
    "allow-get-split-diff-lines",
    "allow-find-diff-row",
    "allow-get-file-contents",
    "allow-get-tree-entry",
    "allow-list-tree",
    "allow-get-file-history",
    "allow-get-file-history-rows",
    "allow-get-blame",
    "allow-get-file-view",
    "allow-get-file-view-lines",
    "allow-save-file-as",
    "allow-list-refs",
    "allow-list-stashes",
    "allow-get-status-summary",
    "allow-list-submodules",
    "allow-get-workbench-layout",
    "allow-save-workbench-layout"
  ]
}
