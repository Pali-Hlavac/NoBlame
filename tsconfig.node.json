{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "src/shared/lib/loadingBird.ts", "scripts/**/*.mjs"],
  // Runs inside the tests' jsdom window, importing the app's test helpers (DOM types).
  "exclude": ["scripts/a11y-setup.mjs"]
}
